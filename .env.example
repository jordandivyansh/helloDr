# Node 24+. The local SQLite store is created automatically.
PORT=4000
API_URL=http://127.0.0.1:4000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/clinic.sqlite
# Demo mode seeds fictional records and displays demo login buttons. Never use real data here.
DEMO_MODE=true
# For a non-demo database: set DEMO_MODE=false and supply these before the first start.
# CLINIC_ADMIN_EMAIL=doctor@example.com
# CLINIC_ADMIN_PASSWORD=choose-a-long-unique-password
# COOKIE_SECURE=true

# Optional parent assistant: server-only settings; never prefix these with NEXT_PUBLIC_.
# OPENAI_API_KEY=configure-securely
# OPENAI_MODEL=your-structured-output-capable-model
